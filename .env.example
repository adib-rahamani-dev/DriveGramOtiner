TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL_ID=
# Private destination: leave blank and use the authenticated panel pairing link.
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_API_URL=http://bot-api:8081
# cloud uses https://api.telegram.org and sends complete files up to 50 MB without API ID/hash.
TELEGRAM_API_MODE=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback
DATABASE_URL=postgresql+psycopg://drivegram:CHANGE_ME@db:5432/drivegram
POSTGRES_PASSWORD=CHANGE_ME
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional Argon2 hash; when set, takes priority over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
POLL_INTERVAL_SECONDS=60
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_TRANSFERS=1
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=1800
UPLOAD_TIMEOUT_SECONDS=3600
LEASE_SECONDS=120
DISK_RESERVE_MB=512
TEMP_DIR=/transfers
PUBLIC_BASE_URL=http://localhost:8000
# Set true behind HTTPS; false is only for local development.
COOKIE_SECURE=true
PANEL_BIND=127.0.0.1:8000
# Vercel entrypoint forces these true; keep false for the local Compose panel.
REMOTE_WORKER=false
DATABASE_NO_POOL=false
